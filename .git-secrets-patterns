# Git secrets patterns to prevent accidental commits
# Common secret patterns

# AWS Keys
[Aa](CCESS|ccess)?_?[Kk](EY|ey)?_?[Ii](D|d)?[\s]*[:=][\s]*[A-Z0-9]{20}
[Ss](ECRET|ecret)?_?[Aa](CCESS|ccess)?_?[Kk](EY|ey)?[\s]*[:=][\s]*[A-Za-z0-9/+=]{40}

# API Keys (generic)
[Aa][Pp][Ii]_?[Kk][Ee][Yy][\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]
[Aa][Pp][Ii]_?[Ss][Ee][Cc][Rr][Ee][Tt][\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]

# Private Keys
-----BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY

# JWT Secrets
JWT_SECRET[\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{32,}['\"]

# Database URLs with passwords
postgres:\/\/[^:]+:[^@]+@
mysql:\/\/[^:]+:[^@]+@
mongodb:\/\/[^:]+:[^@]+@

# Slack tokens
xox[baprs]-[0-9a-zA-Z]{10,48}

# Generic tokens
[Tt][Oo][Kk][Ee][Nn][\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]
[Aa][Cc][Cc][Ee][Ss][Ss]_?[Tt][Oo][Kk][Ee][Nn][\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]

# Password in connection strings
password=[\S]+

# OAuth secrets
client_secret[\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]

# Encryption keys
encryption_key[\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]
ENCRYPTION_KEY[\s]*[:=][\s]*['\"][A-Za-z0-9\-_]{20,}['\"]
